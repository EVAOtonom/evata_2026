<?xml version="1.0"?>
<package format="3">
  <name>right_side_bias_layer</name>
  <version>0.1.0</version>
  <description>Nav2 Costmap2D layer for smooth right-side lane preference.</description>
  <maintainer email="maintainer@example.com">EVA Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <costmap_2d plugin="${prefix}/right_side_bias_layer.xml" />
  </export>
</package>
